{
  "schemaVersion": 2,
  "runtimePolicy": "endpointHints are display/configuration hints only; live rosapi endpoint and type discovery is authoritative for control",
  "templates": [
    {
      "id": "scorpion_v1",
      "name": "Scorpion V1",
      "description": "Standard Scorpion AMR platform",
      "rosBridgePort": 9090,
      "defaultParams": {
        "max_trans_vel": 0.8,
        "max_rot_vel": 1.0,
        "dock_type": "LV_dock",
        "camera_count": 2
      },
      "topics": {
        "bms": "/{robotId}/bms",
        "robotState": "/{robotId}/robot_state",
        "pose": "/{robotId}/amcl_pose",
        "map": "/{robotId}/map",
        "scan": "/{robotId}/scan",
        "cam1Color": "/{robotId}/cam_1/color/image_raw/compressed",
        "cam2Color": "/{robotId}/cam_2/color/image_raw/compressed"
      },
      "endpointHints": {
        "goal": "/{robotId}/TARU/goal",
        "cancel": "/{robotId}/TARU/cancel"
      }
    },
    {
      "id": "scorpion_v2",
      "name": "Scorpion V2",
      "description": "Enhanced Scorpion with lift mechanism",
      "rosBridgePort": 9090,
      "defaultParams": {
        "max_trans_vel": 1.0,
        "max_rot_vel": 1.5,
        "dock_type": "LV_dock",
        "camera_count": 2,
        "has_lift": true
      },
      "topics": {
        "bms": "/{robotId}/bms",
        "robotState": "/{robotId}/robot_state",
        "pose": "/{robotId}/amcl_pose",
        "map": "/{robotId}/map",
        "scan": "/{robotId}/scan",
        "cam1Color": "/{robotId}/cam_1/color/image_raw/compressed",
        "cam2Color": "/{robotId}/cam_2/color/image_raw/compressed",
        "liftStatus": "/{robotId}/lift_status"
      },
      "endpointHints": {
        "goal": "/{robotId}/TARU/goal",
        "cancel": "/{robotId}/TARU/cancel",
        "lift": "/{robotId}/TARU/lift"
      }
    },
    {
      "id": "conveyor_bot",
      "name": "Conveyor Bot",
      "description": "AMR with conveyor belt system",
      "rosBridgePort": 9090,
      "defaultParams": {
        "max_trans_vel": 0.6,
        "max_rot_vel": 0.8,
        "dock_type": "Rack_dock",
        "camera_count": 1,
        "has_conveyor": true
      },
      "topics": {
        "bms": "/{robotId}/bms",
        "robotState": "/{robotId}/robot_state",
        "pose": "/{robotId}/amcl_pose",
        "map": "/{robotId}/map",
        "scan": "/{robotId}/scan",
        "cam1Color": "/{robotId}/cam_1/color/image_raw/compressed",
        "conveyorStatus": "/{robotId}/conveyor_status"
      },
      "endpointHints": {
        "goal": "/{robotId}/TARU/goal",
        "cancel": "/{robotId}/TARU/cancel",
        "conveyor": "/{robotId}/TARU/conveyor"
      }
    },
    {
      "id": "stl_ulsan",
      "name": "STL Ulsan (STL1000W / STL1500W)",
      "description": "ROBOT_MODEL이 stl1000w 또는 stl1500w인 로봇의 service lift, turntable 및 map lifecycle",
      "rosBridgePort": 9090,
      "defaultParams": {
        "max_trans_vel": 0.8,
        "max_rot_vel": 1.0,
        "camera_count": 1,
        "has_lift": true,
        "compatibility_profile": "stl_ulsan"
      },
      "topics": {
        "bms": "/{robotId}/bms",
        "robotState": "/{robotId}/robot_state",
        "pose": "/{robotId}/amcl_pose",
        "map": "/{robotId}/map",
        "scan": "/{robotId}/scan",
        "mappingMode": "/{robotId}/spcore/MODE",
        "liftFeedback": "/{robotId}/Lift/feedback"
      },
      "endpointHints": {
        "goal": "/{robotId}/TARU/goal",
        "cancel": "/{robotId}/TARU/cancel",
        "lift": "/{robotId}/Lift/cmd",
        "liftCancel": "/{robotId}/Lift/cancel",
        "turntable": "/{robotId}/Turntable/cmd",
        "turntableCancel": "/{robotId}/Turntable/cancel",
        "saveMap": "/{robotId}/save_map",
        "reloadMap": "/{robotId}/change_map",
        "staticMap": "/{robotId}/static_map"
      }
    },
    {
      "id": "custom",
      "name": "Custom Robot",
      "description": "User-defined robot configuration",
      "rosBridgePort": 9090,
      "defaultParams": {
        "max_trans_vel": 0.5,
        "max_rot_vel": 0.5,
        "dock_type": "L_dock",
        "camera_count": 0
      },
      "topics": {
        "bms": "/{robotId}/bms",
        "robotState": "/{robotId}/robot_state",
        "pose": "/{robotId}/amcl_pose",
        "map": "/{robotId}/map",
        "scan": "/{robotId}/scan"
      },
      "endpointHints": {
        "goal": "/{robotId}/TARU/goal",
        "cancel": "/{robotId}/TARU/cancel"
      }
    }
  ]
}
